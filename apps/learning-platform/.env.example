# Secrets used only by the learning-platform application.
LEARNING_ADMIN_PASSWORD=change-me

# Runtime storage boundaries. Local development discovers the checkout only when
# LEARNING_CONTENT_ROOT is omitted; production deployments should set all three.
LEARNING_CONTENT_ROOT=/content
LEARNING_CATALOG_PATH=docs/learning-platform/catalog.yaml
LEARNING_NEW_SPACES_PATH=docs/learning-spaces
LEARNING_DATA_DIR=/data

# Optional. Omit this in a read-only deployment. When set, the content root must
# be inside this Git working tree so authoring can commit exact paths safely.
LEARNING_GIT_ROOT=/content
